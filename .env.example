BOT_TOKEN=токен_от_BotFather
# ID через запятую: её и твой. Пусто = бот отвечает всем.
# Узнать свой ID: написать боту @userinfobot
ALLOWED_USER_IDS=123456789,987654321
# ID её аккаунта: только ей будут приходить автоматические сообщения (иначе всем, кто нажал /start).
GIRLFRIEND_ID=987654321
# ID твоего аккаунта: сюда придут её ответы по кнопке «ответить андрею».
OWNER_ID=123456789
# Если Telegram заблокирован, укажи прокси (иначе оставь пустым):
# PROXY_URL=socks5://127.0.0.1:1080
# PROXY_URL=http://127.0.0.1:8080
PROXY_URL=
